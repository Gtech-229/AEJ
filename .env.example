# Required environment variables.
# Copy this file to `.env` (or `.env.local`) and adjust for your environment.
# Validated at startup by `env.ts` — a missing/invalid value fails the build.

# Base URL of the backend API (must be a valid URL, no trailing slash).
# NEXT_PUBLIC_API_URL="https://apis.aej-ci.net/public/api"
NEXT_PUBLIC_API_URL=http://localhost:8000/api
