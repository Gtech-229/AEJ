

# Base path the BROWSER calls. Keep it relative so requests go through the
# Next rewrites (same-origin → no CORS, first-party Sanctum cookies).
NEXT_PUBLIC_API_URL="/api"

# Absolute backend origin, no trailing slash. Used by the rewrites in
# next.config.ts and by server-side fetches (RSC prefetch).
BACKEND_ORIGIN="https://apis.aej-ci.net/public"
